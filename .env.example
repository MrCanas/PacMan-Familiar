# Ranking compartido (opcional).
#
# Sin estas dos variables el juego funciona igual, pero el boton de ranking
# no aparece. Para activarlo:
#   1. Crea un proyecto gratis en https://supabase.com
#   2. Ejecuta supabase/schema.sql en el SQL Editor
#   3. Copia este fichero a .env.local y pega ahi tus dos claves
#      (Supabase -> Settings -> API)
#
# .env.local esta en .gitignore: no se sube al repositorio.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
